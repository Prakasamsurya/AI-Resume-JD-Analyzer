      "parameters": {
        "jsCode": "const chain3 = $('JD Verification').item.json.output;\n\nconst raw = $json.text ?? $json.output ?? $json.response ?? $json;\n\nif (typeof raw !== 'string' || !raw.trim()) {\n  throw new Error('Chain4 returned an empty response.');\n}\n\nconst text = raw.trim();\n\nfunction getSection(name, nextSection) {\n  const startMarker = name + ':';\n  const start = text.indexOf(startMarker);\n\n  if (start === -1) {\n    return '';\n  }\n\n  const contentStart = start + startMarker.length;\n\n  let contentEnd = text.length;\n\n  if (nextSection) {\n    const next = text.indexOf(nextSection + ':', contentStart);\n\n    if (next !== -1) {\n      contentEnd = next;\n    }\n  }\n\n  return text\n    .substring(contentStart, contentEnd)\n    .trim();\n}\n\nfunction getList(name, nextSection) {\n  const section = getSection(name, nextSection);\n\n  if (!section || section.toUpperCase() === 'NONE') {\n    return [];\n  }\n\n  return section\n    .split('\\n')\n    .map(item => item.trim())\n    .filter(item => item.length > 0)\n    .map(item => item.replace(/^\\d+[\\.\\)]\\s*/, ''))\n    .filter(item => item.length > 0);\n}\n\nlet recommendation = getSection(\n  'RECOMMENDATION',\n  'WHY'\n).split('\\n')[0]?.trim() || '';\n\nconst validRecommendations = [\n  'APPLY',\n  'APPLY_AFTER_CHANGES',\n  'REVIEW_REQUIRED',\n  'NOT_RECOMMENDED'\n];\n\nif (!validRecommendations.includes(recommendation)) {\n  recommendation = 'REVIEW_REQUIRED';\n}\n\nconst why = getSection(\n  'WHY',\n  'RESUME_IMPROVEMENTS'\n);\n\nconst resumeImprovements = getList(\n  'RESUME_IMPROVEMENTS',\n  'RELEVANT_PROJECTS'\n);\n\nconst relevantProjects = getList(\n  'RELEVANT_PROJECTS',\n  'SKILLS_TO_PREPARE'\n);\n\nconst skillsToPrepare = getList(\n  'SKILLS_TO_PREPARE',\n  'INTERVIEW_QUESTIONS'\n);\n\nconst interviewQuestions = getList(\n  'INTERVIEW_QUESTIONS',\n  'ACTION_PLAN'\n);\n\nconst actionPlan = getList(\n  'ACTION_PLAN',\n  null\n);\n\nconst finalReport = {\n  recommendation,\n  why,\n\n  requirement_analysis:\n    chain3.requirement_analysis ?? [],\n\n  strong_matches:\n    chain3.strong_matches ?? [],\n\n  weak_matches:\n    chain3.weak_matches ?? [],\n\n  not_demonstrated:\n    chain3.not_demonstrated ?? [],\n\n  resume_improvements:\n    resumeImprovements,\n\n  relevant_projects:\n    relevantProjects,\n\n  skills_to_prepare:\n    skillsToPrepare,\n\n  interview_questions:\n    interviewQuestions,\n\n  action_plan:\n    actionPlan\n};\n\nreturn [\n  {\n    json: {\n      output: finalReport\n    }\n  }\n];"
