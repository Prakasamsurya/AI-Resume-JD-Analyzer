      "parameters": {
        "jsCode": "const resumeRaw = $('Final Resume Builder').item.json.text;\n\nif (!resumeRaw || !resumeRaw.trim()) {\n  throw new Error('Final Resume Builder returned an empty response.');\n}\n\nlet cleaned = resumeRaw\n  .trim()\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .replace(/\\\\_/g, '_')\n  .trim();\n\nlet optimizedResume;\n\ntry {\n  optimizedResume = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(\n    'Final Resume Builder returned invalid JSON: ' + error.message\n  );\n}\n\nconst reportText = $('Final Report').item.json.text || '';\n\nconst verification =\n  $('JD Verification').item.json.output || {};\n\nconst improvementRaw =\n  $('Resume Improvement').item.json.text || '';\n\nlet improvementData = {\n  improvements: [],\n  cannot_add: []\n};\n\nif (improvementRaw) {\n  let improvementCleaned = improvementRaw\n    .trim()\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/\\s*```$/i, '')\n    .replace(/\\\\_/g, '_')\n    .trim();\n\n  try {\n    improvementData = JSON.parse(improvementCleaned);\n  } catch (error) {\n    throw new Error(\n      'Resume Improvement returned invalid JSON: ' + error.message\n    );\n  }\n}\n\nconst recommendationMatch = reportText.match(\n  /RECOMMENDATION:\\s*([A-Z_]+)/\n);\n\nconst whyMatch = reportText.match(\n  /WHY:\\s*([\\s\\S]*?)(?=\\nRESUME_IMPROVEMENTS:)/\n);\n\nconst improvementsMatch = reportText.match(\n  /RESUME_IMPROVEMENTS:\\s*([\\s\\S]*?)(?=\\nRELEVANT_PROJECTS:)/\n);\n\nconst projectsMatch = reportText.match(\n  /RELEVANT_PROJECTS:\\s*([\\s\\S]*?)(?=\\nSKILLS_TO_PREPARE:)/\n);\n\nconst skillsMatch = reportText.match(\n  /SKILLS_TO_PREPARE:\\s*([\\s\\S]*?)(?=\\nINTERVIEW_QUESTIONS:)/\n);\n\nconst questionsMatch = reportText.match(\n  /INTERVIEW_QUESTIONS:\\s*([\\s\\S]*?)(?=\\nACTION_PLAN:)/\n);\n\nconst actionPlanMatch = reportText.match(\n  /ACTION_PLAN:\\s*([\\s\\S]*)$/\n);\n\nfunction parseNumberedList(value) {\n  if (!value) return [];\n\n  if (value.trim() === 'NONE') {\n    return [];\n  }\n\n  return value\n    .split('\\n')\n    .map(line => line.trim())\n    .filter(Boolean)\n    .map(line => line.replace(/^\\d+\\.\\s*/, ''));\n}\n\nconst analysis = {\n  recommendation: recommendationMatch\n    ? recommendationMatch[1].trim()\n    : null,\n\n  why: whyMatch\n    ? whyMatch[1].trim()\n    : '',\n\n  requirement_analysis:\n    verification.requirement_analysis || [],\n\n  strong_matches:\n    verification.strong_matches || [],\n\n  weak_matches:\n    verification.weak_matches || [],\n\n  not_demonstrated:\n    verification.not_demonstrated || [],\n\n  resume_improvements:\n    parseNumberedList(\n      improvementsMatch ? improvementsMatch[1] : ''\n    ),\n\n  relevant_projects:\n    parseNumberedList(\n      projectsMatch ? projectsMatch[1] : ''\n    ),\n\n  skills_to_prepare:\n    parseNumberedList(\n      skillsMatch ? skillsMatch[1] : ''\n    ),\n\n  interview_questions:\n    parseNumberedList(\n      questionsMatch ? questionsMatch[1] : ''\n    ),\n\n  action_plan:\n    parseNumberedList(\n      actionPlanMatch ? actionPlanMatch[1] : ''\n    ),\n\n  optimization_ledger:\n    improvementData.improvements || [],\n\n  excluded_requirements:\n    improvementData.cannot_add || []\n};\n\nreturn [\n  {\n    json: {\n      analysis,\n      optimized_resume: optimizedResume\n    }\n  }\n];"
